@model appReversotask1.Models.Paciente

@{
    ViewData["Title"] = "Detalhes do Paciente";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0 rounded-4">
            <!-- Cabeçalho -->
            <div class="card-header bg-primary bg-gradient text-white p-4 rounded-top-4 border-0">
                <h4 class="fw-bold mb-1">
                    <i class="bi bi-person-lines-fill me-2"></i>Detalhes do Paciente
                </h4>
                <p class="text-white-50 mb-0 small">Informações cadastrais e de contato do paciente</p>
            </div>

            <!-- Corpo com Dados -->
            <div class="card-body p-4">
                <dl class="row mb-0 gy-3 align-items-center">
                    <dt class="col-sm-4 text-muted fw-semibold">
                        @Html.DisplayNameFor(model => model.Nome)
                    </dt>
                    <dd class="col-sm-8 fw-semibold text-dark mb-0">
                        @Html.DisplayFor(model => model.Nome)
                    </dd>

                    <dt class="col-sm-4 text-muted fw-semibold">
                        @Html.DisplayNameFor(model => model.Cpf)
                    </dt>
                    <dd class="col-sm-8 text-dark mb-0">
                        <span class="badge bg-light text-dark border px-3 py-2 fw-semibold">
                            @Html.DisplayFor(model => model.Cpf)
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted fw-semibold">
                        @Html.DisplayNameFor(model => model.Telefone)
                    </dt>
                    <dd class="col-sm-8 text-dark mb-0">
                        <i class="bi bi-telephone text-secondary me-1"></i>
                        @Html.DisplayFor(model => model.Telefone)
                    </dd>

                    <dt class="col-sm-4 text-muted fw-semibold">
                        @Html.DisplayNameFor(model => model.DataNascimento)
                    </dt>
                    <dd class="col-sm-8 text-dark mb-0">
                        <i class="bi bi-calendar-event text-secondary me-1"></i>
                        @Html.DisplayFor(model => model.DataNascimento)
                    </dd>
                </dl>
            </div>

            <!-- Rodapé com Ações -->
            <div class="card-footer bg-light p-3 rounded-bottom-4 border-0 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Voltar</a>
                <a asp-action="Edit" asp-route-id="@Model?.Codigo" class="btn btn-primary px-4 fw-bold shadow-sm">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
            </div>
        </div>
    </div>
</div>