@model appReversotask1.Models.Medico

@{
    ViewData["Title"] = "Cadastrar Médico";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0 rounded-4">
            <!-- Cabeçalho -->
            <div class="card-header bg-primary bg-gradient text-white p-4 rounded-top-4 border-0">
                <h4 class="fw-bold mb-1">Cadastrar Médico</h4>
                <p class="text-white-50 mb-0 small">Insira os dados do profissional de saúde</p>
            </div>

            <!-- Formulário -->
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <!-- Nome -->
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold text-secondary">Nome Completo</label>
                        <input asp-for="Nome" class="form-control" placeholder="Dr. João Silva" />
                        <span asp-validation-for="Nome" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- CRM -->
                    <div class="mb-3">
                        <label asp-for="Crm" class="form-label fw-semibold text-secondary">CRM</label>
                        <input asp-for="Crm" class="form-control" placeholder="000000/UF" />
                        <span asp-validation-for="Crm" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Especialidade -->
                    <div class="mb-4">
                        <label asp-for="Especialidade" class="form-label fw-semibold text-secondary">Especialidade</label>
                        <input asp-for="Especialidade" class="form-control" placeholder="Ex: Cardiologia, Ortopedia..." />
                        <span asp-validation-for="Especialidade" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Voltar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">Cadastrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}