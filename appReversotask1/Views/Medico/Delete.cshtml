@model appReversotask1.Models.Medico

@{
    ViewData["Title"] = "Excluir Médico";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0 rounded-4">
            <!-- Cabeçalho de Alerta -->
            <div class="card-header bg-danger bg-gradient text-white p-4 rounded-top-4 border-0">
                <h4 class="fw-bold mb-1">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Excluir Médico
                </h4>
                <p class="text-white-50 mb-0 small">Esta ação não poderá ser desfeita. Confirme os dados antes de prosseguir.</p>
            </div>

            <!-- Corpo com Dados -->
            <div class="card-body p-4">
                <div class="alert alert-warning border-0 rounded-3 mb-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-circle-fill fs-4 me-3 text-warning"></i>
                    <div>
                        Tem certeza de que deseja remover este médico do sistema?
                    </div>
                </div>

                <dl class="row mb-0 gy-3">
                    <dt class="col-sm-4 text-muted fw-semibold">
                        @Html.DisplayNameFor(model => model.Nome)
                    </dt>
                    <dd class="col-sm-8 fw-semibold text-dark mb-0">
                        @Html.DisplayFor(model => model.Nome)
                    </dd>

                    <dt class="col-sm-4 text-muted fw-semibold">
                        @Html.DisplayNameFor(model => model.Crm)
                    </dt>
                    <dd class="col-sm-8 text-dark mb-0">
                        @Html.DisplayFor(model => model.Crm)
                    </dd>

                    <dt class="col-sm-4 text-muted fw-semibold">
                        @Html.DisplayNameFor(model => model.Especialidade)
                    </dt>
                    <dd class="col-sm-8 text-dark mb-0">
                        @Html.DisplayFor(model => model.Especialidade)
                    </dd>
                </dl>
            </div>

            <!-- Rodapé com Formulário e Botões -->
            <div class="card-footer bg-light p-3 rounded-bottom-4 border-0">
                <form asp-action="Delete" class="d-flex justify-content-between align-items-center mb-0">
                    <input type="hidden" asp-for="Codigo" />
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Voltar</a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                        <i class="bi bi-trash me-1"></i>Confirmar Exclusão
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>