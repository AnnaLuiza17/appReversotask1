@model IEnumerable<appReversotask1.Models.Consulta>

@{
    ViewData["Title"] = "Consultas Agendadas";
}

<div class="container mt-4">
    <!-- Cabeçalho com Ação Principal -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Consultas</h3>
            <p class="text-muted small mb-0">Gerencie os agendamentos da clínica</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm px-3">
            + Nova Consulta
        </a>
    </div>

    <!-- Tabela em Card -->
    <div class="card shadow border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.DataHora)</th>
                            <th>@Html.DisplayNameFor(model => model.StatusConsulta)</th>
                            <th>@Html.DisplayNameFor(model => model.Medico)</th>
                            <th>@Html.DisplayNameFor(model => model.Paciente)</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Nenhuma consulta encontrada.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        @Html.DisplayFor(modelItem => item.DataHora)
                                    </td>
                                    <td>
                                        @switch (item.StatusConsulta)
                                        {
                                            case "Realizada":
                                                <span class="badge bg-success rounded-pill px-3 py-2">Realizada</span>
                                                break;
                                            case "Cancelada":
                                                <span class="badge bg-danger rounded-pill px-3 py-2">Cancelada</span>
                                                break;
                                            default:
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">@item.StatusConsulta</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Medico.Nome)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Paciente.Nome)
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-outline-primary">Editar</a>
                                            <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-outline-info">Detalhes</a>
                                            <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-outline-danger">Excluir</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>