@{
    ViewData["Title"] = "Página Inicial";
}

<!-- Ícones do Bootstrap (pode ser incluído no _Layout.cshtml) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<!-- Hero / Banner de Boas-vindas -->
<div class="p-4 p-md-5 mb-4 bg-white rounded-4 shadow-sm border-0">
    <div class="container-fluid py-2">
        <div class="row align-items-center">
            <div class="col-lg-8 text-center text-lg-start">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 mb-3">
                    <i class="bi bi-hospital me-1"></i> Sistema de Gestão
                </span>
                <h1 class="display-5 fw-bold text-dark mb-3">Bem-vindo à Clínica Vida & Saúde</h1>
                <p class="fs-5 text-muted mb-4">
                    Gerencie agendamentos, consultas e informações dos pacientes de forma rápida, simples e intuitiva.
                </p>
                <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start">
                    <a asp-controller="Consulta" asp-action="Index" class="btn btn-primary btn-lg fw-bold shadow-sm px-4">
                        <i class="bi bi-calendar2-check me-2"></i>Ver Consultas
                    </a>
                    <a asp-controller="Consulta" asp-action="Create" class="btn btn-outline-primary btn-lg fw-semibold px-4">
                        <i class="bi bi-plus-lg me-2"></i>Nova Consulta
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <i class="bi bi-heart-pulse-fill text-primary opacity-75" style="font-size: 8rem;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Atalhos Rápidos -->
<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-calendar-event fs-3"></i>
                </div>
                <h5 class="fw-bold">Consultas</h5>
                <p class="text-muted small">Visualize, edite ou cancele as consultas agendadas na clínica.</p>
                <a asp-controller="Consulta" asp-action="Index" class="btn btn-link text-decoration-none fw-semibold p-0">Acessar Consultas &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-person-plus fs-3"></i>
                </div>
                <h5 class="fw-bold">Novo Paciente</h5>
                <p class="text-muted small">Cadastre novos pacientes para liberação de agendamentos no sistema.</p>
                <a asp-controller="Paciente" asp-action="Create" class="btn btn-link text-decoration-none fw-semibold p-0">Cadastrar Paciente &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <div class="bg-info-subtle text-info rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-shield-lock fs-3"></i>
                </div>
                <h5 class="fw-bold">Acesso ao Sistema</h5>
                <p class="text-muted small">Área de autenticação para acesso aos serviços do paciente.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-link text-decoration-none fw-semibold p-0">Ir para Login &rarr;</a>
            </div>
        </div>
    </div>
</div>